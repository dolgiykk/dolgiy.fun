APP_NAME=DOLGIY.FUN
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dolgiy.fun
FRONTEND_URL=https://dolgiy.fun

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dolfun
DB_USERNAME=dolfun
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=dolgiy.fun
SANCTUM_STATEFUL_DOMAINS=dolgiy.fun,www.dolgiy.fun

ADMIN_EMAIL=admin@dolgiy.fun
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
AVATAR_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=redis
PLATFORM_CACHE_STORE=redis
RUTUBE_CHANNEL_ID=25340957
RUTUBE_CACHE_STORE=redis
RUTUBE_CACHE_TTL=3600
VK_APP_ID=54726663

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="admin@dolgiy.fun"
MAIL_FROM_NAME="DOLGIY.FUN"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dolgiy-fun
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# SMTP fallback (often blocked on VPS outbound :587). Prefer MAIL_MAILER=resend.
