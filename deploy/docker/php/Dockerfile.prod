FROM composer:2 AS vendor

WORKDIR /app

COPY backend/composer.json backend/composer.lock ./

RUN composer install \
    --no-dev \
    --no-scripts \
    --prefer-dist \
    --no-interaction \
    --no-progress

COPY backend/ .

RUN composer dump-autoload --optimize --classmap-authoritative --no-dev --no-scripts \
    && php -r "file_exists('bootstrap/cache') || mkdir('bootstrap/cache', 0775, true);"


FROM php:8.4-fpm-alpine

WORKDIR /var/www/html

RUN apk add --no-cache \
        bash \
        curl \
        icu-dev \
        libzip-dev \
        oniguruma-dev \
        postgresql-dev \
        $PHPIZE_DEPS \
    && docker-php-ext-install \
        pdo \
        pdo_pgsql \
        pgsql \
        intl \
        bcmath \
        exif \
        pcntl \
        zip \
        opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del $PHPIZE_DEPS \
    && rm -rf /tmp/pear /var/cache/apk/*

COPY deploy/docker/php/php.prod.ini /usr/local/etc/php/conf.d/99-production.ini
COPY deploy/docker/php/entrypoint.prod.sh /usr/local/bin/entrypoint.prod.sh
RUN chmod +x /usr/local/bin/entrypoint.prod.sh

COPY --from=vendor /app /var/www/html

# Build-time env must not use empty DB_CONNECTION with CACHE_STORE=database:
# AppServiceProvider registers RateLimiter, which resolves the cache store and boots DB.
RUN cp .env.example .env \
    && CACHE_STORE=array \
       SESSION_DRIVER=array \
       QUEUE_CONNECTION=sync \
       DB_CONNECTION=sqlite \
       APP_KEY=base64:dGVtcG9yYXJ5LWtleS1mb3ItZG9ja2VyLWJ1aWxkLW9ubHk= \
       php artisan package:discover --ansi \
    && rm .env \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/entrypoint.prod.sh"]
